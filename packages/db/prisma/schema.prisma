// Prisma schema — Ambit derived/indexed state (brief §24).
// Migrations only; never modify production schema manually.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Canonical agent row, keyed by agentRegistry (eip155:chainId:registry:agentId).
model Agent {
  id                      String    @id
  agentRegistry           String    @unique
  agentId                 String
  chainId                 Int
  identityRegistry        String
  owner                   String
  agentWallet             String?
  agentURI                String
  name                    String
  description             String
  image                   String?
  category                String? // 'rebalancing' | 'grid-trading' | 'health-factor' | 'yield' | null
  capabilities            String[] // JSON-encoded array via app layer
  supportedProtocols      String[]
  verificationTier        String    @default("unverified")
  supportedExecution      Boolean   @default(false)
  executionVerified       Boolean   @default(false)
  verifiedActivity        Boolean   @default(false)
  activityTransactionCount Int?
  activityObservedAtBlock  Int?
  activityObservedAt       DateTime?
  trustScoreValue         Int?
  trustConfidence         String    @default("none")
  trustConfidenceRank     Int       @default(0)
  trustMethodologyVersion String?
  trustComputedAt         DateTime?
  lastIndexedBlock        Int?
  lastIndexedAt           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  metadata    AgentMetadata[]
  endpoint    AgentEndpoint[]
  reputation  ReputationEvent[]
  activity    ActivityEvent[]
  payment     PaymentEvidence[]
  trustScores TrustScore[]
  policy      ExecutionPolicy[]
  executions  ExecutionRequest[]

  @@index([category])
  @@index([verificationTier])
  @@index([chainId])
  @@index([trustScoreValue, trustConfidenceRank])
  @@index([executionVerified])
}

model AgentMetadata {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  data        String // JSON-encoded registration file
  source      String
  blockNumber Int?
  txHash      String
  timestamp   DateTime @default(now())

  @@unique([agentId, source, txHash])
}

model AgentEndpoint {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  url         String
  status      String    @default("unknown") // unknown | up | down | degraded
  lastChecked DateTime?
  latencyMs   Int?

  @@unique([agentId, url])
}

model ReputationEvent {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientAddress String
  value         String // decimal string (int128 scaled)
  valueDecimals Int
  tag1          String?
  tag2          String?
  endpoint      String?
  feedbackURI   String?
  feedbackHash  String?
  blockNumber   Int
  txHash        String
  logIndex      Int
  timestamp     DateTime @default(now())

  @@index([agentId])
  @@index([clientAddress])
  @@unique([txHash, logIndex])
}

model ActivityEvent {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind        String
  blockNumber Int
  txHash      String
  timestamp   DateTime @default(now())

  @@index([agentId])
}

model PaymentEvidence {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  source       String   @default("x402")
  linkedTxHash String?
  chainId      Int?
  reliable     Boolean  @default(false)
  observedAt   DateTime @default(now())

  @@index([agentId])
}

model TrustScore {
  id                 String   @id @default(cuid())
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  score              Int
  confidence         String // none | low | medium | high
  methodologyVersion String
  evidence           String // JSON-encoded Evidence[]
  computedAt         DateTime @default(now())

  @@unique([agentId, methodologyVersion, computedAt])
  @@index([agentId])
}

model ExecutionPolicy {
  id               String    @id @default(cuid())
  agentId          String
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  maxTxValue       String? // decimal string
  dailySpend       String?
  allowedTokens    String[]
  allowedProtocols String[]
  allowedTargets   String[]
  expiry           DateTime?
  maxSlippageBps   Int?
  minHealthFactor  String?
  createdAt        DateTime  @default(now())
}

model ExecutionRequest {
  id                String    @id @default(cuid())
  agentId           String
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  clientRequestId   String?   @unique
  requester         String?
  sessionId         String?
  destination       String
  calldata          String?
  protocol          String?
  requestedValue    String
  requestStatus     String    @default("pending-authorization")
  policyResult      String    @default("pending") // pending | approved | rejected
  riskResult        String?
  simulationResult  String?
  approvalRejection String    @default("pending") // pending | approved | rejected
  rejectionReason   String?
  callsId           String?
  txHash            String?
  blockNumber       Int?
  blockHash         String?
  executionStatus   String?
  gas               String?
  outcome           String?
  passportId        String?   @unique
  verifiedAt        DateTime?
  timestamp         DateTime  @default(now())

  @@index([agentId])
  @@index([agentId, timestamp])
  @@index([timestamp])
  @@index([txHash])
}

model Attestation {
  id                 String   @id @default(cuid())
  epoch              Int
  merkleRoot         String
  agentCount         Int
  methodologyVersion String
  timestamp          DateTime
  txHash             String?

  @@unique([epoch])
}

model IndexerCheckpoint {
  id        String   @id @default(cuid())
  chainId   Int
  contract  String
  lastBlock Int
  updatedAt DateTime @default(now())

  @@unique([chainId, contract])
}
