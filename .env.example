# ============================================================
# Ambit — environment configuration (copy to .env, never commit .env)
# ============================================================

# --- BNB Smart Chain (mainnet, chainId 56) ---
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_CHAIN_ID=56

# --- BNB Smart Chain testnet (chainId 97, used for safe execution demos) ---
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_CHAIN_ID=97

# --- ERC-8004 registry addresses on BSC ---
# Filled at M1 from the live 8004scan /networks page (authoritative source).
ERC8004_IDENTITY_REGISTRY_BSC=
ERC8004_REPUTATION_REGISTRY_BSC=

# --- Database (Postgres) ---
DATABASE_URL=postgresql://ambit:ambit@localhost:5432/ambit

# --- API (Hono) ---
API_PORT=8787

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Indexer ---
INDEXER_BATCH_SIZE=200
# Optional: block to start indexing from. If unset, indexer uses on-chain checkpoint.
INDEXER_START_BLOCK=
