# ============================================================
# Ambit — environment configuration (copy to .env, never commit .env)
# ============================================================

# --- Database (Postgres; docker compose up -d provides this) ---
DATABASE_URL=postgresql://ambit:ambit@localhost:5432/ambit

# --- BSC RPC (REQUIRED, reliable endpoint — public RPCs rate-limit) ---
# Mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_CHAIN_ID=56
# Testnet (optional)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_CHAIN_ID=97

# --- ERC-8004 registries on BSC (RECON-VERIFIED 2026-08-16 via 8004scan -> bscscan) ---
# Do NOT change without re-verifying against 8004scan.io/networks first.
ERC8004_IDENTITY_REGISTRY_BSC=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY_BSC=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# --- Indexer ---
INDEXER_BATCH_SIZE=200
# INDEXER_START_BLOCK=41000000

# --- API ---
API_PORT=8787
NEXT_PUBLIC_API_URL=http://localhost:8787
# Runtime-only API credential used by the server-side hire proxy; never expose as NEXT_PUBLIC_*.
AMBIT_HIRE_TOKEN=

# --- Partner integrations (populated in later milestones) ---
# ALTANA_API_KEY=
# PANCAKESWAP_*
# TERMIX_*
